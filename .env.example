# =============================================================================
# INMAQUI BACKEND - Variables de Entorno de Ejemplo
# NO colocar contraseñas ni secretos reales en este archivo
# =============================================================================

# Base de datos MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USUARIO=inmaqui_user
DB_PASSWORD=cambiar_password_segura

# Nombres de esquemas por microservicio
DB_USUARIOS_NAME=inmaqui_usuarios
DB_CATALOGO_NAME=inmaqui_catalogo
DB_VENTAS_NAME=inmaqui_ventas

# Seguridad y JWT (RS256)
JWT_ISSUER=inmaqui-usuarios
JWT_EXPIRATION_MINUTES=60

# Token de comunicación interna entre microservicios (Catalogo <-> Ventas)
INTERNAL_SERVICE_TOKEN=inmaqui-secreto-interno-cambiar-en-produccion

# Credenciales del Administrador Inicial (usuarios-service)
ADMIN_INIT_USERNAME=admin_inmaqui
ADMIN_INIT_PASSWORD=CambiarPasswordAdmin2026!
ADMIN_INIT_CORREO=admin@inmaqui.cl
ADMIN_INIT_RUT=11111111-1

# URLs entre servicios
CATALOGO_SERVICE_URL=http://127.0.0.1:8082
